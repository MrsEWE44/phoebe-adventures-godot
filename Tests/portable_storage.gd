extends SceneTree
const Store = preload("res://Scence/data_storage.gd")
var count := 0
var failures := 0
func ck(value: bool, label: String) -> void:
	count += 1
	if not value: failures += 1; push_error(label)
func put(path: String, contents: String) -> void:
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var file := FileAccess.open(path,FileAccess.WRITE)
	file.store_string(contents)
	file.close()
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var c = root.get_node("Campaign")
	var storage = root.get_node("Storage")
	var audio = root.get_node("Global")
	c.saving_enabled = false
	c.reset_state(41)
	c.profile.coins = 1324
	var fixture := ProjectSettings.globalize_path("res://.godot/storage-tests/"+str(Time.get_ticks_usec()))
	var legacy := fixture.path_join("legacy")
	var destination := fixture.path_join("游戏 文件夹/Data")
	var data: Dictionary = {"version":1,"active_level":0,"hub_chapter":4,"completed":[],"states":{},"profile":c.profile.duplicate(true)}
	var original := JSON.stringify(data)
	put(legacy.path_join("campaign_v1.json"),original)
	put(legacy.path_join("campaign_v1.json.bak"),original)
	put(legacy.path_join("campaign_v1.json.before-test.bak"),"historical backup")
	put(legacy.path_join("audio_settings.cfg"),'[audio]\nMusic=-33.0\nEnemyVoice=-11.0\n')
	put(legacy.path_join("unrelated.txt"),"not game data")
	ck(Store.resolve_data_root(true,"E:/Project/Game/","E:/Engine/Godot.exe")=="E:/Project/Game/Data","editor uses project instead of engine directory")
	ck(Store.resolve_data_root(false,"res://","D:/Games/菲比/Game.exe")=="D:/Games/菲比/Data","export uses executable directory including Unicode")
	ck(Store.script_run(),"test scripts never auto-migrate live player data")
	ck(c.save_path==storage.save_file() and audio.settings_path==storage.settings_file(),"campaign and settings share storage resolver")
	ck(not ProjectSettings.get_setting("debug/file_logging/enable_file_logging"),"built-in system-directory file log disabled")
	ck(not ProjectSettings.get_setting_with_override("debug/file_logging/enable_file_logging"),"desktop feature override cannot re-enable system logs")
	var local_store = Store.new()
	ck(local_store.initialize(destination,legacy,false)==OK,"initialize portable directories and migration")
	for folder in ["Saves","Settings","Backups","Logs"]:
		ck(DirAccess.dir_exists_absolute(destination.path_join(folder)),"created "+folder)
	ck(FileAccess.file_exists(destination.path_join(".gdignore")),"private data excluded from Godot resource import")
	ck(FileAccess.get_file_as_string(local_store.save_file())==original,"primary migration byte-identical")
	ck(FileAccess.get_file_as_string(local_store.save_file()+".bak")==original,"recovery backup preserved")
	ck(FileAccess.get_file_as_string(destination.path_join("Backups/campaign_v1.json.before-test.bak"))=="historical backup","historical backup migrated")
	ck(not FileAccess.file_exists(destination.path_join("unrelated.txt")),"unrelated legacy files not copied")
	var cfg := ConfigFile.new()
	ck(cfg.load(local_store.settings_file())==OK and cfg.get_value("audio","Music")==-33.0,"audio settings migrate")
	ck(FileAccess.get_file_as_string(legacy.path_join("campaign_v1.json"))==original,"legacy save never modified")
	ck(FileAccess.file_exists(destination.path_join(Store.MIGRATION_MARKER)),"migration completion marked")
	put(legacy.path_join("campaign_v1.json"),"changed old save")
	ck(local_store.initialize(destination,legacy,false)==OK and FileAccess.get_file_as_string(local_store.save_file())==original,"later startups never resurrect or overwrite from legacy")
	c.save_path = local_store.save_file()
	ck(c.load_progress() and c.player_level()==41 and c.profile.coins==1324,"campaign loads portable save")
	c.profile.coins = 1400
	c.saving_enabled = true
	ck(c.save_progress(),"campaign writes portable save")
	ck(JSON.parse_string(FileAccess.get_file_as_string(local_store.save_file()+".bak")).profile.coins==1324,"atomic backup remains in Saves")
	ck(c.load_progress() and c.profile.coins==1400,"saved portable progress reloads")
	c.saving_enabled = false
	# Local progress (including a backup-only recovery) takes precedence over migration.
	var conflict := fixture.path_join("existing/Data")
	put(conflict.path_join("Saves/campaign_v1.json.bak"),"local backup")
	put(conflict.path_join("Settings/audio_settings.cfg"),"local settings")
	var conflict_store = Store.new()
	ck(conflict_store.initialize(conflict,legacy,false)==OK,"existing local data migration initialization")
	ck(not FileAccess.file_exists(conflict_store.save_file()),"local backup prevents stale legacy primary import")
	ck(FileAccess.get_file_as_string(conflict_store.save_file()+".bak")=="local backup","existing backup unchanged")
	ck(FileAccess.get_file_as_string(conflict_store.settings_file())=="local settings","existing settings unchanged")
	conflict_store.free()
	var fresh_store = Store.new()
	ck(fresh_store.initialize(fixture.path_join("fresh/Data"),fixture.path_join("missing"),false)==OK,"new installation without legacy data")
	ck(not FileAccess.file_exists(fresh_store.save_file()),"fresh installation starts without fabricated progress")
	fresh_store.free()
	# Native Godot output is captured by the portable Logger after initialization.
	ck(local_store.initialize(destination,legacy,true)==OK,"portable logger starts")
	print("PORTABLE_LOG_PROBE")
	var log_path := destination.path_join("Logs/game.log")
	ck(FileAccess.get_file_as_string(log_path).contains("PORTABLE_LOG_PROBE"),"engine output reaches Data/Logs")
	local_store._exit_tree()
	ck(local_store.initialize(destination,legacy,true)==OK,"logger restarts")
	ck(FileAccess.get_file_as_string(destination.path_join("Logs/game.previous.log")).contains("PORTABLE_LOG_PROBE"),"previous session log rotated locally")
	local_store._exit_tree()
	local_store.free()
	var blocked := fixture.path_join("blocked")
	put(blocked,"a file, not a writable directory")
	var bad_store = Store.new()
	ck(bad_store.initialize(blocked,legacy,false)!=OK and not bad_store.last_error.is_empty(),"unwritable location returns error without system fallback")
	bad_store.free()
	print("PORTABLE STORAGE: %d checks, %d failures" % [count,failures])
	quit(1 if failures else 0)
