event_text = {"idle": ["你怎么不理我呀？我会乖乖等你的。", "我只是想离你近一点，可以吗？"], "battle": ["别担心，我会轻轻地，让它们安静下来。", "你看着就好，这次换我保护你。"], "hurt": ["好疼呀，你会心疼我的，对不对？", "呜，怎么可以欺负我呢？"], "death": ["对不起，我真的，已经很努力了。"], "angry": ["我都没有生气呢，你们怎么还不肯停手呀？"], "afraid": ["这里好暗，你不会丢下我吧？"], "terrified": ["啊！吓到我了，别突然过来呀！"], "proud": ["只是随便拉了一下，你就这么惊讶呀？"], "skill": ["听好了，这段旋律，只送给你。"], "ultimate": ["不许再打扰我们了。终曲，共鸣！"], "victory": ["赢了呢。你最喜欢的，还是我的琴声吧？"], "exhausted": ["让我靠一会儿，好不好？"], "dialogue": ["我没有别的意思，只是有一点担心你。", "谢谢你来救我。以后，也让我陪着你吧。"], "interaction": ["我没有别的意思，只是有一点担心你。", "谢谢你来救我。以后，也让我陪着你吧。"]}
