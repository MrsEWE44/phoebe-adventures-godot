afraid = Array[AudioStream]([ExtResource("alert")])
terrified = Array[AudioStream]([ExtResource("startled")])
proud = Array[AudioStream]([ExtResource("proud")])
dialogue = Array[AudioStream]([ExtResource("alert")])
hurt = Array[AudioStream]([ExtResource("hurt")])
skill = Array[AudioStream]([ExtResource("skill")])
ultimate = Array[AudioStream]([ExtResource("skill")])
victory = Array[AudioStream]([ExtResource("victory")])
exhausted = Array[AudioStream]([ExtResource("determined")])
