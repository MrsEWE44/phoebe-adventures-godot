[resource]
script = ExtResource("1")
idle = Array[AudioStream]([ExtResource("question"), ExtResource("care")])
death = Array[AudioStream]([ExtResource("no")])
interaction = Array[AudioStream]([ExtResource("question"), ExtResource("care"), ExtResource("sorry"), ExtResource("busy"), ExtResource("method")])
angry = Array[AudioStream]([ExtResource("angry"), ExtResource("busy")])
afraid = Array[AudioStream]([ExtResource("afraid")])
terrified = Array[AudioStream]([ExtResource("terrified")])
proud = Array[AudioStream]([ExtResource("proud")])
dialogue = Array[AudioStream]([ExtResource("care"), ExtResource("question")])
hurt = Array[AudioStream]([ExtResource("hurt"), ExtResource("sorry")])
skill = Array[AudioStream]([ExtResource("skill"), ExtResource("method")])
battle = Array[AudioStream]([ExtResource("skill"), ExtResource("method"), ExtResource("proud")])
ultimate = Array[AudioStream]([ExtResource("skill")])
victory = Array[AudioStream]([ExtResource("success")])
exhausted = Array[AudioStream]([ExtResource("sad")])
