# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Large binary media is stored with Git LFS.
Videos/*.mp4 filter=lfs diff=lfs merge=lfs -text
Videos/*.ogv filter=lfs diff=lfs merge=lfs -text
BGM/* filter=lfs diff=lfs merge=lfs -text
Audio/**/* filter=lfs diff=lfs merge=lfs -text
